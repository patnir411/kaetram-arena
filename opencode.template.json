{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "kaetram": {"name": "kaetram"},
        "qwen3.5:9b": {"name": "qwen3.5:9b"},
        "qwen3.5:4b": {"name": "qwen3.5:4b"}
      }
    }
  },
  "mcp": {
    "kaetram": {
      "type": "local",
      "command": [
        "__VENV_PYTHON__",
        "__PROJECT_DIR__/mcp_game_server.py"
      ],
      "enabled": true
    }
  }
}
