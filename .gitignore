.venv
.venv/

# Screenshots and session state (generated at runtime)
state/*.png
state/session*.json
state/game_state.json
state/game_state.tmp
state/.session_counter

# Kaetram-Open server (installed locally, not part of this repo)
/Kaetram-Open/
.playwright-mcp/

# Root-level test screenshots
*.png

# Recordings and highlights
recordings/
highlights/

# Generated architecture/explainer diagrams (never tracked)
.codeviz/

# Model checkpoints (large weights)
world/checkpoints/

# Python
__pycache__/
*.pyc
.pytest_cache/
tests/state/
logs/
artifacts/

# Training data (generated, stays on VM — do not commit)
dataset/extracted*/
dataset/qwen_sft*/
dataset/qwen_kto*/
dataset/raw/
dataset/session*/
dataset/_archive/
dataset/opd_probe/
dataset/opd_2b/round*/*
dataset/opd_r11/

# Exception: track the active SFT build's README so provenance docs land in git
!dataset/qwen_sft/README.md
# Exception: gate outputs are small provenance artifacts — keep them in git
!dataset/opd_2b/round*/gate_*.txt

# Claude session-local scheduler state (root + nested project dirs)
.claude/scheduled_tasks.lock
**/.claude/scheduled_tasks.lock

# MCP config (template with placeholders resolved at launch)
.mcp.json

# Ephemeral runtime state
.turn_counter
state/

# Kaetram Learn (separate repo)
kaetram-learn/
